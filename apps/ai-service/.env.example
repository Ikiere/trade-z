# AI Service
AI_API_HOST=0.0.0.0
AI_API_PORT=8000
AI_DEBUG=true

# Backend
AI_BACKEND_URL=http://localhost:3001/api/v1

# Market Data (Twelve Data recommended)
AI_MARKET_DATA_API_KEY=your_api_key
AI_MARKET_DATA_PROVIDER=twelve_data

# AI Confidence
AI_MIN_CONFIDENCE_THRESHOLD=85.0
AI_HIGH_CONFIDENCE_THRESHOLD=95.0

# LLM (optional — for AI chat, e.g. OpenRouter)
AI_LLM_API_KEY=your_openrouter_api_key
AI_LLM_MODEL=google/gemini-2.5-flash:free
AI_LLM_PROVIDER=openrouter
