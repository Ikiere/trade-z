# ==============================================================================
# TRADE-Z ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env or .env.local and populate with your environment secrets.
# NEVER commit real private keys, tokens, or credentials into source control.
# ==============================================================================

# --- Supabase Database & Auth ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Service Communication URLs ---
PORT=3001
AI_SERVICE_URL=http://127.0.0.1:8000
MT5_BRIDGE_URL=http://127.0.0.1:5001

# --- MT5 Desktop Bridge Security ---
MT5_BRIDGE_HOST=127.0.0.1
MT5_BRIDGE_PORT=5001
MT5_BRIDGE_SECRET=your-secure-bridge-shared-secret
MT5_BRIDGE_ALLOWED_ORIGIN=http://localhost:3000

# --- Market Data Providers ---
TWELVE_DATA_API_KEY=your-twelvedata-api-key

# --- AI & LLM Advisory Review ---
OPENROUTER_API_KEY=your-openrouter-api-key
DEFAULT_AI_MODEL=deepseek/deepseek-chat

# --- Payment & Billing (Paystack / Stripe) ---
PAYSTACK_SECRET_KEY=your-paystack-secret-key
PAYSTACK_PUBLIC_KEY=your-paystack-public-key

# --- Email & Notifications ---
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=alerts@trade-z.com

# --- Monitoring & Observability ---
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
